# Commission Portal — copy to .env.local and fill in.

# Supabase: Project Settings → API Keys (and Data API for the URL).
# The legacy names NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY also work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# The built-in Executive: an @ust.edu.ph Google account that always has portal access and adds
# everyone else under Accounts.
PORTAL_EXECUTIVE_EMAIL=
PORTAL_EXECUTIVE_NAME=Executive

# Emails to applicants (submission confirmation, accepted/rejected), sent through Gmail.
# SMTP_USER is the Google account that sends them. SMTP_PASSWORD is a 16-character app password
# from Google Account → Security → 2-Step Verification → App passwords, not the account password.
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=UST Central Comelec

# The public website address, used for links inside emails (e.g. https://comelec.example.com).
# Leave blank while developing; links then point to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
