# Commission Portal — copy to .env.local and fill in.

# Supabase: Project Settings → API Keys (and Data API for the URL).
# The legacy names NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY also work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# The built-in Executive: an @ust.edu.ph Google account that always has portal access and adds
# everyone else under Accounts.
PORTAL_EXECUTIVE_EMAIL=
PORTAL_EXECUTIVE_NAME=Executive

# Every email the site sends, through Gmail: the automatic ones (receipts, results, notices to the
# commission, account changes) and the portal's Email Sender. They all leave from this one mailbox,
# the Central Comelec's, whichever unit they concern.
# SMTP_USER is the Google account that sends them. SMTP_PASSWORD is a 16-character app password
# from Google Account → Security → 2-Step Verification → App passwords, not the account password.
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=UST Central Comelec

# Scheduled emails from the portal's Email Sender. On a server that keeps running (next start, a
# VPS or container) they go out by themselves and this isn't needed. On hosting that only runs
# while answering a request (Vercel and the like), set a long random value here and have a cron job
# call /api/email/dispatch every minute with the header "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# File storage on Cloudflare R2 (Supabase only holds the database). Two buckets:
#   R2_PUBLIC_BUCKET  — member photos and event-form images. Leave R2_PUBLIC_URL blank and the site
#                       serves them itself at /files/…. Once there's a domain, connect one under the
#                       bucket's Settings → Custom Domains (e.g. https://files.example.com) and put it
#                       in R2_PUBLIC_URL; files are then loaded from Cloudflare directly. Avoid the
#                       r2.dev address: some networks block it.
#   R2_PRIVATE_BUCKET — Political Party registration documents. Leave it private; the portal hands
#                       out one-minute download links.
# R2 → Manage API tokens → Create API token, permission "Object Read & Write" limited to those two
# buckets, gives the access key ID and secret. The account ID is on the R2 overview page.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_URL=

# PDF uploads for documents, stored in the commission's Google Drive. Optional: without these the
# document form only takes a pasted Drive link. Run scripts/drive-setup.mjs once to get the values.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# The public website address, used for links inside emails (e.g. https://comelec.example.com).
# Leave blank while developing; links then point to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Rate limits count requests per visitor IP. On Vercel, or behind one proxy (nginx, Caddy) that adds
# to X-Forwarded-For, leave this blank. Behind Cloudflare set it to cf-connecting-ip; behind a proxy
# that sets X-Real-IP, to x-real-ip. It must name a header the proxy overwrites, never one a browser
# could send through untouched.
CLIENT_IP_HEADER=
# Set to 1 to take the whole website, portal included, offline: every address then shows the
# "under maintenance" page with a 503. Remove it or set it to 0 to bring the site back.
# For everyday maintenance use the portal instead (Maintenance), which leaves the portal up.
MAINTENANCE_MODE=
